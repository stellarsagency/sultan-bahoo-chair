{
    "outputDirectory": ".",
    "buildCommand": null,
    "installCommand": null,
    "framework": null,
    "routes": [
        { "src": "/images/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "src": "/css/(.*)", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
        { "src": "/js/(.*)", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
    ]
}